alienMissions:
  - &avxInvestigationMission
    type: STR_AVX_SCIENTIST_ACTIVITY
    points: 0
    objective: 3
    spawnZone: 0
    raceWeights:
      0:
        STR_AVX_HUMAN_FORCES: 100
    waves:
      - ufo: STR_AVX_SCIENTIST_ACTIVITY_SITE
        count: 1
        trajectory: AVX_IMMEDIATE_SITE
        timer: 30
        objective: true

  - &avxHumanInvestigationMission
    type: STR_AVX_HUMAN_INVESTIGATION
    refNode: *avxInvestigationMission
    spawnZone: 1
    waves:
      - ufo: STR_AVX_HUMAN_INVESTIGATION_SITE
        count: 1
        trajectory: AVX_IMMEDIATE_SITE
        timer: 30
        objective: true

  - type: STR_AVX_HUMAN_INVESTIGATION_FIRST_1
