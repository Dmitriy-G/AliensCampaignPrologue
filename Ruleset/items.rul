  - type: STR_AVX_MEDIC_HEAL_TOOL
    weight: 0
    battleType: 9
    LOSRequired: false
    psiRequired: false
    targetMatrix: 7
    power: 20
    damageType: 0
    blastRadius: 0
    damageAlter:
      RandomType: 3
      ArmorEffectiveness: 0
      IgnoreNormalMoraleLose: true
      ToHealth: -0.15
      ToArmor: 0
      ToWound: 0
      ToStun: 0
      ToTile: 0
      ToItem: 0
      ToMorale: 0
    hitSound: 36
    hitAnimation: -1
    hitMissAnimation: -1
    tuUse: 0
    scripts:
      tryPsiAttackItem: |
        return 1;
      hitUnitAmmo: |
        set power 0;
        unit.addHealth 3;
        return power part side;
    recover: false

  - type: STR_AVX_MEDIC_MORALE_TOOL
    weight: 0
    battleType: 9
    LOSRequired: false
    psiRequired: false
    targetMatrix: 7
    power: 20
    damageType: 0
    blastRadius: 0
    damageAlter:
      RandomType: 3
      ArmorEffectiveness: 0
      IgnoreNormalMoraleLose: true
      ToHealth: 0
      ToArmor: 0
      ToWound: 0
      ToStun: 0
      ToTile: 0
      ToItem: 0
      ToMorale: -10
    hitSound: 36
    hitAnimation: -1
    hitMissAnimation: -1
    tuUse: 0
    scripts:
      tryPsiAttackItem: |
        return 1;
      hitUnitAmmo: |
        set power 0;
        unit.addMorale 20;
        return power part side;
    recover: false

  - type: STR_AVX_MEDIC_WOUNDS_TOOL
    weight: 0
    battleType: 9
    LOSRequired: false
    psiRequired: false
    targetMatrix: 7
    power: 20
    damageType: 0
    blastRadius: 0
    damageAlter:
      RandomType: 3
      ArmorEffectiveness: 0
      IgnoreNormalMoraleLose: true
      ToHealth: 0
      ToArmor: 0
      ToWound: 0
      ToStun: 0
      ToTile: 0
      ToItem: 0
      ToMorale: 0
    hitSound: 36
    hitAnimation: -1
    hitMissAnimation: -1
    tuUse: 0
    scripts:
      tryPsiAttackItem: |
        return 1;
      hitUnitAmmo: |
        var int wounds;
        var int treated;

        set power 0;
        unit.getFatalwounds wounds 0;
        if gt wounds 0;
          unit.addFatalwounds 0 -1;
          set treated 1;
        end;
        if eq treated 0;
          unit.getFatalwounds wounds 1;
          if gt wounds 0;
            unit.addFatalwounds 1 -1;
            set treated 1;
          end;
        end;
        if eq treated 0;
          unit.getFatalwounds wounds 2;
          if gt wounds 0;
            unit.addFatalwounds 2 -1;
            set treated 1;
          end;
        end;
        if eq treated 0;
          unit.getFatalwounds wounds 3;
          if gt wounds 0;
            unit.addFatalwounds 3 -1;
            set treated 1;
          end;
        end;
        if eq treated 0;
          unit.getFatalwounds wounds 4;
          if gt wounds 0;
            unit.addFatalwounds 4 -1;
            set treated 1;
          end;
        end;
        if eq treated 0;
          unit.getFatalwounds wounds 5;
          if gt wounds 0;
            unit.addFatalwounds 5 -1;
          end;
        end;
        return power part side;
    recover: false

